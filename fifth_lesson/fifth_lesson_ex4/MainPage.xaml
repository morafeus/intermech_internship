        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Column="1" Grid.Row="1">Главная страница</TextBlock>
        <Button Width="100" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center" Grid.Column="2" Grid.Row="0" Click="Button_Click">Настройки</Button>

    </Grid>
</Page>
